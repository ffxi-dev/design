---
// The family wordmark, sruon ◆ site, with site linking to the site's root.
interface Props {
  site: string;
}
const { site } = Astro.props;
---

<span class="wordmark"><a class="wordmark-prefix" href="https://sruon.dev">sruon</a><svg class="wordmark-glyph" width="10" height="10" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0.5 L11.5 6 L6 11.5 L0.5 6 Z" fill="none" stroke="currentColor" stroke-width="1.2"></path><path d="M6 3 L9 6 L6 9 L3 6 Z" fill="currentColor" opacity="0.4"></path></svg><a class="wordmark-site" href="/">{site}</a></span>
